{
  "name": "commit-message",
  "icon": "resources/icon.png",
  "displayName": "OpenRouter Commit Message",
  "description": "Generate Git commit messages using OpenRouter API directly from your git diff.",
  "version": "0.1.0",
  "publisher": "emanuelsaramago",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuelsaramago/commit-message"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "commit-message.generate",
        "title": "OpenRouter Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "commit-message.setApiKey",
        "title": "OpenRouter Commit Message: Set OpenRouter API Key"
      },
      {
        "command": "commit-message.clearApiKey",
        "title": "OpenRouter Commit Message: Clear OpenRouter API Key"
      },
      {
        "command": "commit-message.selectModel",
        "title": "OpenRouter Commit Message: Select OpenRouter Model"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commit-message.generate",
          "group": "navigation",
          "when": "scmRepositoryCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "OpenRouter Commit Message",
      "properties": {
        "generateCommitMessage.model": {
          "type": "string",
          "default": "auto:free",
          "description": "OpenRouter model to use. Use 'auto:free' to dynamically select active free models, or specify a model ID."
        },
        "generateCommitMessage.includeUnstagedIfNoStaged": {
          "type": "boolean",
          "default": true,
          "description": "If there are no staged changes, use unstaged working tree changes."
        },
        "generateCommitMessage.customPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional extra instructions to append to the commit generation prompt."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/prompt.test.ts --bundle --platform=node --outfile=out/test/prompt.test.js --external:vscode && node --test out/test/prompt.test.js",
    "generate": "npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.4.2"
}
